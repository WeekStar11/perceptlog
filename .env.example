# 复制为 .env 后填写。三种模型任选其一，改 PERCEPTLOG_PROVIDER 即可切换。

# deepseek | openai | ollama | demo
PERCEPTLOG_PROVIDER=deepseek

# ---- 在线：DeepSeek（推荐，国内可直连）----
DEEPSEEK_API_KEY=sk-在这里填你的key
# PERCEPTLOG_MODEL=deepseek-chat
# PERCEPTLOG_BASE_URL=https://api.deepseek.com/v1

# ---- 在线：OpenAI ----
# OPENAI_API_KEY=sk-...
# PERCEPTLOG_MODEL=gpt-4o-mini

# ---- 离线：Ollama ----
# 先 ollama serve，再 ollama pull qwen2.5:7b
# PERCEPTLOG_PROVIDER=ollama
# PERCEPTLOG_MODEL=qwen2.5:7b
# PERCEPTLOG_BASE_URL=http://localhost:11434/v1

# 温度：结构化抽取建议 0.2–0.4
PERCEPTLOG_TEMPERATURE=0.3
